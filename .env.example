# ==============================================================================
# 🏢 THE BORING COMPANY OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your desired AI model provider keys.
# NEVER commit your real .env file with active credentials to git.
# All real secrets are automatically redacted by src/tools/redact.js in logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Model Providers (Choose at least one, or use local Ollama / test mode)
# ------------------------------------------------------------------------------

# Anthropic Claude (Default model: claude-3-7-sonnet-20250219)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# OpenAI (Default model: gpt-4o)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini (Default model: gemini-2.5-pro)
GEMINI_API_KEY=AIzaSy-your-gemini-key-here
GEMINI_MODEL=gemini-2.5-pro

# Local Ollama (Offline, 100% private, zero API keys required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 2. Operating Runtime & Engine Configuration
# ------------------------------------------------------------------------------

# Active Provider: "auto", "anthropic", "openai", "gemini", "ollama", or "test"
BORING_PROVIDER=auto

# Path to the SQLite operating ledger database
BORING_COMPANY_DB=./database/company.db

# Default token cap per mission (Prevents runaway token expenditure)
BORING_TOKEN_LIMIT=100000

# Logging verbosity: "info", "debug", or "silent"
BORING_LOG_LEVEL=info
